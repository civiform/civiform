#! /usr/bin/env bash

# DOC: Poll Floci and block until it is healthy.

source bin/lib.sh

floci_endpoint="http://localhost:4566"

if [ "$1" ]; then
  floci_endpoint="${1}"
fi

echo "Using Floci endpoint: ${floci_endpoint}"

START_TIME="$(date +%s)"
DEADLINE="$(($START_TIME + 200))"

echo "Waiting for Floci to get set up..."

# Floci returns compact JSON and reports SES under its signing name, "email".
healthy() {
  [[ "${1}" =~ \"s3\":\ ?\"(available|running)\" &&
    "${1}" =~ \"email\":\ ?\"(available|running)\" ]]
}

readonly HEALTH_URL="${floci_endpoint}/_floci/health"

until healthy "$(curl --silent --fail --max-time 2 "${HEALTH_URL}")"; do
  if (("$(date +%s)" > "${DEADLINE}")); then
    out::error "deadline exceeded waiting for Floci start"
    exit 1
  fi
  sleep 1
done

bin/floci/mk-s3
bin/floci/ses-verify-identity "noreply@fake.identity"
