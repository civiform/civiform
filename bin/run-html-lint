#! /usr/bin/env bash

# DOC: Lints the Thymeleaf templates in server/app/views with html-validate.
# DOC: Rules live in server/.htmlvalidate.mjs; the Thymeleaf plugin, custom
# DOC: rules and cf:* element metadata live in server/html-validate.
# DOC: Arguments are passed to html-validate, e.g. bin/run-html-lint --fix

source bin/lib.sh
docker::set_project_name_dev

bin/pull-image

interactive_flag="$(docker::interactive_flags)"

# bin/run-ts-tests installs into the same mounted server/node_modules, so in CI
# the packages are already there. Only install when they are missing or older
# than the lockfile.
docker run --rm $interactive_flag \
  -v "$(pwd)/server:/usr/src/server" \
  --entrypoint /bin/bash \
  civiform/civiform-dev \
  -c "if [[ ! node_modules/.package-lock.json -nt package-lock.json ]]; then npm ci; fi && npm run lint:html -- $*"
