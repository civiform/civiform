%NAME inputField - required text input with a value and no errors
%TEMPLATE_MODE HTML
%CONTEXT
field = new views.trustedintermediary.TrustedIntermediaryClientInfoForm$Field("Ada", @com.google.common.collect.ImmutableList@of())
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{trustedintermediary/fragments/ClientInfoForm :: inputField('text', 'first-name-input', 'firstName', 'First name', true, ${field}, null, null, null)}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-2">
  <label for="first-name-input" class="usa-label mt-0"
    >First name<span class="usa-hint--required" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <input
      type="text"
      value="Ada"
      maxlength="10000"
      aria-required="true"
      id="first-name-input"
      name="firstName"
      class="usa-input"
    />
    <div id="first-name-input-errors" class="text-red-600 text-xs p-1 hidden">
    </div>
  </div>
</div>
