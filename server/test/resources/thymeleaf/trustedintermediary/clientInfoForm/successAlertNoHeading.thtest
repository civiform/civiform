%NAME successAlert - without a heading
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{trustedintermediary/fragments/ClientInfoForm :: successAlert(null, 'Client info has been successfully updated.')}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div
  class="usa-alert usa-alert--success mb-4 w-3/5"
  aria-live="polite"
  role="alert"
>
  <div class="usa-alert__body">
    <p class="usa-alert__text">Client info has been successfully updated.</p>
  </div>
</div>
