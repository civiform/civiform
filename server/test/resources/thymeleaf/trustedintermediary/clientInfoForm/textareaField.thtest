%NAME textareaField - optional textarea holding its value
%TEMPLATE_MODE HTML
%CONTEXT
field = new views.trustedintermediary.TrustedIntermediaryClientInfoForm$Field("Prefers <email>", @com.google.common.collect.ImmutableList@of())
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{trustedintermediary/fragments/ClientInfoForm :: textareaField('ti-note-input', 'tiNote', 'Notes (optional)', ${field})}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-2">
  <label for="ti-note-input" class="usa-label mt-0"
    >Notes (optional)<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <textarea
      maxlength="10000"
      id="ti-note-input"
      name="tiNote"
      class="usa-textarea"
    >Prefers &lt;email&gt;</textarea>
    <div id="ti-note-input-errors" class="text-red-600 text-xs p-1 hidden">
    </div>
  </div>
</div>
