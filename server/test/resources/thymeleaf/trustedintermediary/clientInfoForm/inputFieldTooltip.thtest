%NAME inputField - tooltip follows the label text after a space
%TEMPLATE_MODE HTML
%CONTEXT
field = new views.trustedintermediary.TrustedIntermediaryClientInfoForm$Field("ada@example.com", @com.google.common.collect.ImmutableList@of())
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{trustedintermediary/fragments/ClientInfoForm :: inputField('email', 'email-input', 'emailAddress', 'Email (optional)', false, ${field}, null, null, 'Add an email address.')}"></div>
%INPUT[admin/shared/LegacySvgFragments]
<svg th:fragment="iconInfo(classes)" th:text="|iconInfo(${classes})|"></svg>
<svg th:fragment="iconArrowLeft(classes)" th:text="|iconArrowLeft(${classes})|"></svg>
# ----------------------------------------------------------------------
# No whitespace inside the label after its text: the tooltip div is inline.
%OUTPUT
<div class="mb-2">
  <label for="email-input" class="usa-label mt-0">Email (optional) <span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span><span><div class="group inline"><svg>iconInfo(inline-block w-5 relative)</svg><span class="hidden z-50 group-hover:block bg-white rounded-3xl p-2 px-4 text-black absolute border-gray-200 border text-left w-96 text-sm font-normal whitespace-normal max-w-fit mt-2.5">Add an email address.</span></div></span></label>
  <div class="flex flex-col">
    <input
      type="email"
      value="ada@example.com"
      maxlength="10000"
      id="email-input"
      name="emailAddress"
      class="usa-input"
    />
    <div id="email-input-errors" class="text-red-600 text-xs p-1 hidden">
    </div>
  </div>
</div>
