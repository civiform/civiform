%NAME textField - required, renders value
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/shared/LegacyFieldWithLabel/TextField :: textField('question-name', 'questionName', 'Administrative identifier', 'my-question', true)}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-2">
  <label
    for="question-name"
    class="pointer-events-none text-gray-600 text-base px-1 py-2"
    >Administrative identifier<span class="usa-hint--required" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <input
      type="text"
      value="my-question"
      maxlength="10000"
      aria-required="true"
      id="question-name"
      name="questionName"
      class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
    />
    <div id="question-name-errors" class="text-red-600 text-xs p-1 hidden"></div>
  </div>
</div>
