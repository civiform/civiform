%NAME emailField - not required, renders the sticky value
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/shared/LegacyFieldWithLabel/EmailField :: emailField('group-name-input', 'emailAddress', 'Member email address', 'jane@example.com', false)}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-2">
  <label
    for="group-name-input"
    class="pointer-events-none text-gray-600 text-base px-1 py-2"
    >Member email address<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <input
      type="email"
      value="jane@example.com"
      maxlength="10000"
      id="group-name-input"
      name="emailAddress"
      class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
    />
    <div id="group-name-input-errors" class="text-red-600 text-xs p-1 hidden"></div>
  </div>
</div>
