%NAME textField - not required, null value renders an empty value attribute
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/shared/LegacyFieldWithLabel/TextField :: textField('question-description', 'questionDescription', 'Question note for admin use only', null, false)}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-2">
  <label
    for="question-description"
    class="pointer-events-none text-gray-600 text-base px-1 py-2"
    >Question note for admin use only<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <input
      type="text"
      value=""
      maxlength="10000"
      id="question-description"
      name="questionDescription"
      class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
    />
    <div id="question-description-errors" class="text-red-600 text-xs p-1 hidden"></div>
  </div>
</div>
