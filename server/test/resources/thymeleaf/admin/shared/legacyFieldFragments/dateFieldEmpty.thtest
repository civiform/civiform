%NAME dateField - no value, 'flex' wrapper replacing the default mb-2 (applications list filters)
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/shared/LegacyFieldWithLabel/DateField :: dateField('AbCdEfGh', 'fromDate', 'from:', '', 'flex')}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="flex">
  <label
    for="AbCdEfGh"
    class="pointer-events-none text-gray-600 text-base px-1 py-2"
    >from:<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <input
      type="date"
      value=""
      maxlength="10000"
      id="AbCdEfGh"
      name="fromDate"
      class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
    />
    <div id="AbCdEfGh-errors" class="text-red-600 text-xs p-1 hidden"></div>
  </div>
</div>
