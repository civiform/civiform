%NAME emailField - optional, empty value renders an empty value attribute
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/shared/LegacyFieldWithLabel/EmailField :: emailField('email-input', 'email', 'Email', '', false)}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-2">
  <label
    for="email-input"
    class="pointer-events-none text-gray-600 text-base px-1 py-2"
    >Email<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <input
      type="email"
      value=""
      maxlength="10000"
      id="email-input"
      name="email"
      class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
    />
    <div id="email-input-errors" class="text-red-600 text-xs p-1 hidden"></div>
  </div>
</div>
