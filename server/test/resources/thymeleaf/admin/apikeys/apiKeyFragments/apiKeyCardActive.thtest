%NAME apiKeyCard - active key shows the retire form and its program grants
%TEMPLATE_MODE HTML
%CONTEXT
templateGlobals = @views.shared.TemplateGlobals@builder().csrfToken("token").build()
apiKey = @views.admin.apikeys.ApiKeyIndexPageViewModel$ApiKey@builder() \
    .name("Test API key").status("active").nameSlug("test-api-key") \
    .keyId("key-id").subnets("1.1.1.1/32") \
    .expirationDate("2100-01-01") \
    .createdDate("2024/01/01 at 9:00 AM PST") \
    .createdBy("admin@example.com") \
    .lastCallIp("N/A").callCount(0L) \
    .retired(false) \
    .retireUrl("/admin/apiKeys/7/retire") \
    .grants(@com.google.common.collect.ImmutableList@of( \
        @views.admin.apikeys.ApiKeyIndexPageViewModel$ProgramGrant@builder() \
            .programName("Utility Discount").programSlug("utility-discount") \
            .permission("READ").build())) \
    .build()
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/apikeys/fragments/ApiKeyCard :: apiKeyCard(${apiKey})}"></div>
# ----------------------------------------------------------------------
# The icon is faked so this test stays about the card; iconDelete has its own
# thtests under admin/shared/legacySvgFragments/.
%INPUT[admin/shared/LegacySvgFragments]
<svg th:fragment="iconDelete(classes)" th:text="|iconDelete(${classes})|"></svg>
# ----------------------------------------------------------------------
%OUTPUT
<div
  class="width-full margin-bottom-3 padding-2 bg-white border-1px border-base-lighter radius-md shadow-3"
>
  <h2 class="margin-top-0 margin-bottom-1 cf-api-key-name">
    Test API key<span class="text-base-dark font-sans-xs text-normal"> active</span>
  </h2>
  <div class="display-flex flex-justify flex-wrap">
    <div>
      <p class="margin-0 cf-bt-api-key-id">ID: key-id</p>
      <p class="margin-0 text-base-dark font-sans-xs">Allowed subnets: 1.1.1.1/32</p>
      <p class="margin-0 text-base-dark font-sans-xs cf-bt-date">Expires on: 2100-01-01</p>
    </div>
    <div class="font-sans-3xs">
      <p class="margin-0 cf-bt-date">Created 2024/01/01 at 9:00 AM PST</p>
      <p class="margin-0 cf-bt-api-key-created-by">Created by admin@example.com</p>
      <p class="margin-0" id="test-api-key-last-call-ip">Last used by N/A</p>
      <p class="margin-0" id="test-api-key-call-count">Call count: 0</p>
    </div>
  </div>
  <div class="display-flex flex-justify flex-align-end margin-top-2 flex-wrap">
    <table class="usa-table usa-table--borderless usa-table--compact margin-0">
      <thead>
        <tr>
          <th scope="col">Program name</th>
          <th scope="col">Program slug</th>
          <th scope="col">Permission</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Utility Discount</td>
          <td>utility-discount</td>
          <td>READ</td>
        </tr>
      </tbody>
    </table>
    <form
      action="/admin/apiKeys/7/retire"
      method="POST"
      id="retire-test-api-key"
      data-api-key-name="Test API key"
      class="retire-key-form"
    >
      <input hidden value="token" name="csrfToken" />
      <button
        type="submit"
        class="usa-button usa-button--outline display-flex flex-align-center margin-right-0"
      >
        <svg>iconDelete(usa-icon margin-right-05)</svg>
        <span>Retire key</span>
      </button>
    </form>
  </div>
</div>
