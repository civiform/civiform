%NAME textField - required, custom maxlength, mb-4 wrapper
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/programs/fragments/TextField :: textField('program-display-short-description-input', 'localizedShortDescription', 'Short description of this program for the public. Maximum 100 characters.', 'Get food', true, false, '100', 'mb-4')}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-4">
  <label
    for="program-display-short-description-input"
    class="pointer-events-none text-gray-600 text-base px-1 py-2"
    >Short description of this program for the public. Maximum 100 characters.<span class="usa-hint--required" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <input
      type="text"
      value="Get food"
      maxlength="100"
      aria-required="true"
      id="program-display-short-description-input"
      name="localizedShortDescription"
      class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
    />
    <div id="program-display-short-description-input-errors" class="text-red-600 text-xs p-1 hidden"></div>
  </div>
</div>
