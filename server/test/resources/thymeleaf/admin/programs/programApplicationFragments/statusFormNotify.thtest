%NAME statusUpdateForm - email configured and applicant reachable: checked notify checkbox with the addresses
%TEMPLATE_MODE HTML
%CONTEXT
templateGlobals = @views.shared.TemplateGlobals@builder().csrfToken("token").build()
modal = @views.admin.programs.ProgramApplicationPageViewModel$StatusModal@builder() \
    .id("uuid-modal").statusText("Approved") \
    .previousStatusDisplay("Unset").previousStatusData("") \
    .emailMode(@views.admin.programs.ProgramApplicationPageViewModel$StatusModal$EmailMode@NOTIFY) \
    .emailAddresses("jane@example.com and jane.doe@example.com").build()
# ----------------------------------------------------------------------
%INPUT
<form th:replace="~{admin/programs/fragments/ApplicationStatusModal :: statusUpdateForm(5, 42, 'Utility Discount', 'Doe, Jane (42)', ${modal})}"></form>
# ----------------------------------------------------------------------
%OUTPUT
<form class="cf-program-admin-status-update-form">
  <input name="programId" value="5" hidden />
  <input name="applicationId" value="42" hidden />
  <p>
    <span>Status Change: </span><span class="font-semibold">Unset</span><span class="font-semibold"> -&gt; </span><span class="font-semibold">Approved</span><span> (visible to applicant)</span>
  </p>
  <p>
    <span>Applicant: </span><span class="font-semibold cf-application-id">Doe, Jane (42)</span>
  </p>
  <p>
    <span>Program: </span><span class="font-semibold">Utility Discount</span>
  </p>
  <div class="mt-4">
    <input hidden type="text" name="newStatus" value="Approved" />
    <input hidden type="text" name="currentStatus" value="" />
    <label>
      <input type="checkbox" name="sendEmail" class="h-4 w-4 mr-4 align-middle self-center flex-none" checked />
      <span>Notify </span><span class="font-semibold cf-application-id">Doe, Jane (42)</span><span> of this change at </span><span class="font-semibold">jane@example.com and jane.doe@example.com</span>
    </label>
  </div>
  <div class="flex mt-5 space-x-2">
    <div class="flex-grow"></div>
    <button
      type="button"
      class="cf-modal-close flex items-center font-medium space-x-2 border-none rounded-full bg-transparent text-civiform-blue hover:bg-gray-200"
    >
      Cancel
    </button>
    <button
      type="submit"
      class="flex items-center font-medium space-x-2 border-none rounded-full bg-transparent text-civiform-blue hover:bg-gray-200"
    >
      Confirm
    </button>
    <input hidden value="token" name="csrfToken" />
  </div>
</form>
