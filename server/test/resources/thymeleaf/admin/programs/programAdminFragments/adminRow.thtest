%NAME adminRow - existing program admin row with its delete form (legacy ManageProgramAdminsView.renderExistingAdminRow)
%TEMPLATE_MODE HTML
%CONTEXT
templateGlobals = @views.shared.TemplateGlobals@builder().csrfToken("token").build()
# ----------------------------------------------------------------------
%INPUT
<tr th:replace="~{admin/programs/fragments/ProgramAdminRow :: adminRow('admin@example.com', '/admin/programs/7/admins/delete')}"></tr>
# ----------------------------------------------------------------------
# The icon is faked so this test stays about the row; iconDelete has its own
# thtests under admin/shared/legacySvgFragments/.
%INPUT[admin/shared/LegacySvgFragments]
<svg th:fragment="iconDelete(classes)" th:text="|iconDelete(${classes})|"></svg>
# ----------------------------------------------------------------------
%OUTPUT
<tr class="border-b border-gray-300 even:bg-gray-100">
  <td class="px-4 py-2 pr-12">
    <div class="font-semibold">admin@example.com</div>
  </td>
  <td>
    <div class="flex items-center justify-end gap-3 pr-3">
      <form method="POST" action="/admin/programs/7/admins/delete">
        <input hidden value="token" name="csrfToken" />
        <div class="hidden">
          <label for="admin-email-to-delete" class="sr-only"
            ><span class="usa-hint--required hidden" aria-hidden="true"
              >&nbsp;*</span
            ></label
          >
          <div class="flex flex-col">
            <input
              type="email"
              value="admin@example.com"
              maxlength="10000"
              id="admin-email-to-delete"
              name="adminEmail"
              class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
            />
            <div
              id="admin-email-to-delete-errors"
              class="text-red-600 text-xs p-1 hidden"
            ></div>
          </div>
        </div>
        <button
          class="font-semibold block py-2 text-center rounded-full border text-civiform-blue border-civiform-blue hover:bg-blue-100 flex items-center font-medium space-x-2 bg-white hover:bg-gray-200"
        >
          <svg>iconDelete(inline-block h-4.5 w-4.5)</svg>
          <span class="text-left">Delete</span>
        </button>
      </form>
    </div>
  </td>
</tr>
