%NAME statusItem - status without email or default flag
%TEMPLATE_MODE HTML
%CONTEXT
item = @views.admin.programs.ProgramStatusesPageViewModel$StatusItem@builder() \
    .statusText("Approved").hasEmail(false).defaultStatus(false) \
    .deleteModalId("uuid-delete") \
    .editModal(@views.admin.programs.ProgramStatusesPageViewModel$StatusFormModal@builder() \
        .id("uuid-edit").build()) \
    .build()
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/programs/fragments/ProgramStatusesFragments :: statusItem(${item})}"></div>
# ----------------------------------------------------------------------
# Icons are faked so this test stays about the row; each icon has its own
# thtests under admin/shared/legacySvgFragments/.
%INPUT[admin/shared/LegacySvgFragments]
<svg th:fragment="iconEmail(classes, linkId)" th:text="|iconEmail(${classes})|"></svg>
<svg th:fragment="iconCheck(classes)" th:text="|iconCheck(${classes})|"></svg>
<svg th:fragment="iconDelete(classes)" th:text="|iconDelete(${classes})|"></svg>
<svg th:fragment="iconEdit(classes)" th:text="|iconEdit(${classes})|"></svg>
# ----------------------------------------------------------------------
# The email and default-status columns stay as empty divs, as in the legacy
# condWith rendering; only the template's indentation is left inside them once
# th:if drops the <p>. The trigger button ids are the modal ids + "-button".
%OUTPUT
<div class="cf-admin-program-status-item pl-7 pr-6 py-9 font-normal space-x-2 flex items-center">
  <div class="w-1/4">
    <span class="ml-2 break-words">Approved</span>
  </div>
  <div>
  </div>
  <div class="flex-grow"></div>
  <div>
  </div>
  <div class="flex-grow"></div>
  <button
    id="uuid-delete-button"
    class="flex items-center font-medium space-x-2 border-none rounded-full bg-transparent text-civiform-blue hover:bg-gray-200"
  >
    <svg>iconDelete(inline-block h-4.5 w-4.5)</svg><span class="text-left">Delete</span>
  </button>
  <button
    id="uuid-edit-button"
    class="flex items-center font-medium space-x-2 border-none rounded-full bg-transparent text-civiform-blue hover:bg-gray-200"
  >
    <svg>iconEdit(inline-block h-4.5 w-4.5)</svg><span class="text-left">Edit</span>
  </button>
</div>
