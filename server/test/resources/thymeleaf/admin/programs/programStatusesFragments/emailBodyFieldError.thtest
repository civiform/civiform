%NAME emailBodyField - textarea carrying a validation error keeps its value
%TEMPLATE_MODE HTML
%CONTEXT
errors = @com.google.common.collect.ImmutableList@of("Error: Too long")
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/programs/fragments/ProgramStatusesFragments :: emailBodyField('ijklmnop', 'An email', ${errors})}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mb-2">
  <label for="ijklmnop" class="pointer-events-none text-gray-600 text-base px-1 py-2"
    >Email the applicant about the status change<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
  >
  <div class="flex flex-col">
    <textarea
      rows="5"
      aria-describedby="ijklmnop-errors"
      aria-invalid="true"
      maxlength="10000"
      id="ijklmnop"
      name="emailBody"
      class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border rounded-lg w-full focus:border-civiform-blue placeholder-gray-500 border-red-600"
    >An email</textarea>
    <div id="ijklmnop-errors" class="text-red-600 text-xs p-1">
      <div>Error: Too long</div>
    </div>
  </div>
</div>
