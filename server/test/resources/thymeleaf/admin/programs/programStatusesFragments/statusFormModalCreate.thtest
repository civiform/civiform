%NAME statusFormModal - empty create modal, closed on load, no default status yet
%TEMPLATE_MODE HTML
%CONTEXT
templateGlobals = @views.shared.TemplateGlobals@builder().csrfToken("token").build()
modal = @views.admin.programs.ProgramStatusesPageViewModel$StatusFormModal@builder() \
    .id("uuid-create").creation(true).displayOnLoad(false) \
    .showEmailDeletionWarning(false) \
    .configuredStatusText("").statusText("").emailBody("").defaultStatus(false) \
    .globalErrors(@com.google.common.collect.ImmutableList@of()) \
    .statusTextErrors(@com.google.common.collect.ImmutableList@of()) \
    .emailBodyErrors(@com.google.common.collect.ImmutableList@of()) \
    .build()
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/programs/fragments/ProgramStatusesFragments :: statusFormModal(${modal}, '/admin/programs/7/statuses', null, 'abcdefgh', 'ijklmnop')}"></div>
# ----------------------------------------------------------------------
%INPUT[admin/shared/LegacySvgFragments]
<svg th:fragment="iconClose(classes)" th:text="|iconClose(${classes})|"></svg>
# ----------------------------------------------------------------------
# Without a current default, data-messagepart is the bare "to ". The empty
# global-errors div and the hidden errors divs mirror the legacy output.
%OUTPUT
<div
  id="uuid-create"
  aria-labelledby="uuid-create-title"
  tabindex="0"
  class="cf-modal hidden absolute left-1/2 transform -translate-x-1/2 -translate-y-1/2 rounded-3xl shadow-xl bg-white max-h-screen overflow-y-auto w-11/12 lg:w-1/2 top-1/2"
>
  <div id="uuid-create-title" class="sticky top-0 px-2 pt-2 flex gap-4 place-items-center">
    <div class="text-2xl text-gray-600 my-5 mx-4">Create a new status</div>
    <div class="w-12"></div>
  </div>
  <div class="my-5 mx-6">
    <form
      method="POST"
      action="/admin/programs/7/statuses"
      class="cf-status-change-form py-2"
      data-dontshow="false"
      data-messagepart="to "
    >
      <input type="hidden" value="token" name="csrfToken" />
      <input type="hidden" name="configuredStatusText" value="" />
      <div></div>
      <div class="mb-2">
        <label for="abcdefgh" class="pointer-events-none text-gray-600 text-base px-1 py-2"
          >Status name (required)<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
        >
        <div class="flex flex-col">
          <input
            type="text"
            value=""
            maxlength="10000"
            id="abcdefgh"
            name="statusText"
            class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
          />
          <div id="abcdefgh-errors" class="text-red-600 text-xs p-1 hidden">
          </div>
        </div>
      </div>
      <div class="pt-8">
        <div class="mb-2">
          <label for="ijklmnop" class="pointer-events-none text-gray-600 text-base px-1 py-2"
            >Email the applicant about the status change<span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
          >
          <div class="flex flex-col">
            <textarea
              rows="5"
              maxlength="10000"
              id="ijklmnop"
              name="emailBody"
              class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500"
            ></textarea>
            <div id="ijklmnop-errors" class="text-red-600 text-xs p-1 hidden">
            </div>
          </div>
        </div>
      </div>
      <div class="flex mt-5 space-x-2">
        <label
          ><input
            type="checkbox"
            name="defaultStatusCheckbox"
            class="h-4 w-4 mr-4 align-middle self-center flex-none cf-set-default-status-checkbox"
          /><span>Set as default status</span></label
        >
        <div class="flex-grow"></div>
        <button
          type="submit"
          class="flex items-center font-medium space-x-2 border-none rounded-full bg-transparent text-civiform-blue hover:bg-gray-200"
        >
          Confirm
        </button>
      </div>
    </form>
  </div>
  <button
    type="button"
    aria-label="Close"
    class="cf-modal-close flex items-center font-medium space-x-2 border-none rounded-full bg-transparent text-civiform-blue hover:bg-gray-200 top-0 right-0 absolute my-6 mx-4"
  >
    <svg>iconClose(w-6 h-6 cursor-pointer)</svg>
  </button>
</div>
