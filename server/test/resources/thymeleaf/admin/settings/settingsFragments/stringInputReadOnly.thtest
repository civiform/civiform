%NAME stringInput - read-only setting is disabled, read-only and gets the read-only note
%TEMPLATE_MODE HTML
# ----------------------------------------------------------------------
%INPUT
<div th:replace="~{admin/settings/fragments/SettingInputs :: stringInput('abcdefgh', 'CIVIFORM_IMAGE_TAG', 'v1.2.3', true, null)}"></div>
# ----------------------------------------------------------------------
%OUTPUT
<div class="mt-2">
  <div class="mb-2" data-testid="string-CIVIFORM_IMAGE_TAG">
    <label for="abcdefgh" class="sr-only"
      ><span class="usa-hint--required hidden" aria-hidden="true">&nbsp;*</span></label
    >
    <div class="flex flex-col">
      <input
        type="text"
        value="v1.2.3"
        maxlength="10000"
        id="abcdefgh"
        name="CIVIFORM_IMAGE_TAG"
        placeholder="empty"
        disabled="disabled"
        readonly="readonly"
        class="px-3 bg-white text-black text-lg py-2 block outline-none box-border m-auto border border-gray-500 rounded-lg w-full focus:border-civiform-blue placeholder-gray-500 read-only:text-gray-500 read-only:bg-gray-100"
      />
      <div id="abcdefgh-errors" class="text-red-600 text-xs p-1 hidden"></div>
    </div>
    <div class="text-xs mt-2 text-gray-600">
      Read-only
    </div>
  </div>
</div>
