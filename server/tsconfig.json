{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "target": "es2022",
    // Improve module compatibility with modern bundlers like Webpack.
    "module": "esnext",
    "moduleResolution": "bundler",
    // Allow importing JSON and other non-TS assets if needed.
    "resolveJsonModule": true,
    "sourceMap": true,
    "mapRoot": "/assets/javascripts",
    "sourceRoot": "/assets/javascripts",
    "rootDir": "./app/assets/javascripts",
    "paths": {
      "@/*": ["./app/assets/javascripts/*"],
      "@pages/*": ["./app/assets/javascripts/pages/*"]
    },
    "strict": true,
    // vite/client supplies the ambient types for Vite's asset query imports,
    // such as the `?worker&url` import used to locate the MapLibre worker.
    "types": ["vitest", "vite/client"]
  },
  "include": ["app/assets/javascripts/**/*.ts"]
}
